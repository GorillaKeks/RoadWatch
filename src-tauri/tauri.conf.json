{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoadWatch",
  "version": "0.1.2",
  "identifier": "com.roadwatch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RoadWatch",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFRDdBQkMxM0Q1M0UxMDMKUldRRDRWTTl3YXZYUHJBeHlMWm0zejJJaFFlSjMwMFdGRnU4d3p2RnZ1SW8xemJxVFpEWEZMcXUK",
      "endpoints": [
        "https://github.com/GorillaKeks/RoadWatch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}